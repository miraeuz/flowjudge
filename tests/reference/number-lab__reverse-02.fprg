<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="n,m,x,y,r,s,i,t" type="Integer" array="False" size=""/><input variable="n"/><assign variable="x" expression="n"/><assign variable="s" expression="0"/><while expression="x&gt;0"><assign variable="s" expression="s*10+x mod 10"/><assign variable="x" expression="x div 10"/></while><output expression="s" newline="True"/></body></function></flowgorithm>