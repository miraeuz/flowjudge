<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="n,m,x,y,r,s,i,t" type="Integer" array="False" size=""/><input variable="n"/><assign variable="i" expression="1"/><assign variable="s" expression="1"/><while expression="i&lt;=n"><assign variable="s" expression="s*i"/><assign variable="i" expression="i+1"/></while><output expression="s" newline="True"/></body></function></flowgorithm>