<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="n,m,x,y,r,s,i,t" type="Integer" array="False" size=""/><input variable="n"/><assign variable="x" expression="0"/><assign variable="y" expression="1"/><assign variable="i" expression="0"/><while expression="i&lt;n"><assign variable="t" expression="x+y"/><assign variable="x" expression="y"/><assign variable="y" expression="t"/><assign variable="i" expression="i+1"/></while><output expression="x" newline="True"/></body></function></flowgorithm>