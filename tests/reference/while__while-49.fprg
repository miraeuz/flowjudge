<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="a,b,n,i,j,s,r,k,z,cnt,tmp" type="Integer" array="False" size=""/><assign variable="s" expression="0"/><input variable="a"/><while expression="a&lt;&gt;0"><assign variable="s" expression="s+a div 10"/><input variable="a"/></while><output expression="s" newline="True"/></body></function></flowgorithm>