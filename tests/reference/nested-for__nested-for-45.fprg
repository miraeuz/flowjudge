<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="a,b,n,i,j,s,r,k,z,cnt,tmp" type="Integer" array="False" size=""/><input variable="n"/><input variable="k"/><assign variable="s" expression="0"/><for variable="i" start="1" end="n" direction="inc" step="1"><for variable="j" start="1" end="k" direction="inc" step="1"><input variable="a"/><assign variable="s" expression="s+a+6"/></for></for><output expression="s" newline="True"/></body></function></flowgorithm>