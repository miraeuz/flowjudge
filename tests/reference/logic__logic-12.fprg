<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="a,b,n,i,j,s,r,k,z,cnt,tmp" type="Integer" array="False" size=""/><input variable="a"/><input variable="b"/><if expression="(a&gt;=3) or (b&gt;=3)"><then><assign variable="r" expression="1"/></then><else><assign variable="r" expression="0"/></else></if><output expression="r" newline="True"/></body></function></flowgorithm>