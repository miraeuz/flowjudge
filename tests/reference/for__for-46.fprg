<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="a,b,n,i,j,s,r,k,z,cnt,tmp" type="Integer" array="False" size=""/><input variable="n"/><assign variable="s" expression="0"/><for variable="i" start="1" end="n" direction="inc" step="1"><input variable="a"/><output expression="a div 7" newline="True"/></for></body></function></flowgorithm>