<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="n,m,x,y,r,s,i,t" type="Integer" array="False" size=""/><input variable="n"/><input variable="m"/><assign variable="x" expression="n"/><assign variable="y" expression="m"/><while expression="y&lt;&gt;0"><assign variable="r" expression="x mod y"/><assign variable="x" expression="y"/><assign variable="y" expression="r"/></while><output expression="x" newline="True"/></body></function></flowgorithm>