<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="n,i,j,s,a,k,tmp,r" type="Integer" array="False" size=""/><input variable="n"/><declare name="items" type="Integer" array="True" size="n"/><for variable="i" start="0" end="n-1" direction="inc" step="1"><input variable="items[i]"/></for><for variable="i" start="0" end="n-1" direction="inc" step="1"><if expression="items[i]&lt;5"><then><output expression="items[i]" newline="True"/></then><else></else></if></for></body></function></flowgorithm>