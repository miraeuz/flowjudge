<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="a,b,n,i,j,s,r,k,z,cnt,tmp" type="Integer" array="False" size=""/><input variable="n"/><assign variable="s" expression="0"/><assign variable="r" expression="0"/><for variable="i" start="1" end="n" direction="inc" step="1"><input variable="a"/><if expression="a&lt;=8"><then><assign variable="s" expression="s+a"/></then><else><assign variable="s" expression="s+8"/><assign variable="r" expression="r+a-8"/></else></if></for><output expression="s" newline="True"/><output expression="r" newline="True"/></body></function></flowgorithm>