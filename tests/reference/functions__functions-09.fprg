<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="a,b,n,i,j,s,r,k,z,cnt,tmp" type="Integer" array="False" size=""/><input variable="a"/><input variable="b"/><assign variable="r" expression="Calculate(a,b)"/><output expression="r" newline="True"/></body></function><function name="Calculate" type="Integer" variable="r"><parameters><parameter name="a" type="Integer" array="False"/><parameter name="b" type="Integer" array="False"/></parameters><body><assign variable="r" expression="a*b"/></body></function></flowgorithm>