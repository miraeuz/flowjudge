<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="n,m,x,y,r,s,i,t" type="Integer" array="False" size=""/><input variable="n"/><assign variable="s" expression="1"/><if expression="n&lt;2"><then><assign variable="s" expression="0"/></then><else></else></if><assign variable="i" expression="2"/><while expression="i*i&lt;=n"><if expression="n mod i=0"><then><assign variable="s" expression="0"/></then><else></else></if><assign variable="i" expression="i+1"/></while><output expression="s" newline="True"/></body></function></flowgorithm>