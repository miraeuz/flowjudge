<?xml version="1.0"?><flowgorithm fileversion="2.11"><attributes/><function name="Main" type="None" variable=""><parameters/><body><declare name="a,b,n,i,j,s,r,k,z,cnt,tmp" type="Integer" array="False" size=""/><input variable="n"/><assign variable="s" expression="0"/><assign variable="r" expression="0"/><for variable="i" start="1" end="n" direction="inc" step="1"><input variable="a"/><assign variable="s" expression="s+a"/><if expression="a&gt;=7"><then><assign variable="r" expression="r+1"/></then><else></else></if></for><output expression="s" newline="True"/><output expression="r" newline="True"/></body></function></flowgorithm>