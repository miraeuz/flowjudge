<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="ARKTech"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-20 03:29:08 PM"/>
        <attribute name="created" value="QVJLVGVjaDtERVNLVE9QLUQ5MURPMzE7MjAyNi0xMC0yMDswMzoyNjowOSBQTTsyODkx"/>
        <attribute name="edited" value="QVJLVGVjaDtERVNLVE9QLUQ5MURPMzE7MjAyNi0xMC0yMDswMzoyOTowOCBQTTsxOzMwMDE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c, i, d" type="Integer" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <assign variable="c" expression="a+b"/>
            <assign variable="a" expression="12"/>
            <if expression="b&gt;0">
                <then>
                    <output expression="&quot;asdsad&quot;" newline="True"/>
                    <assign variable="a" expression="a-b"/>
                </then>
                <else>
                    <assign variable="c" expression="c+b"/>
                </else>
            </if>
            <for variable="i" start="0" end="a" direction="inc" step="1">
                <input variable="d"/>
                <assign variable="c" expression="d-i"/>
            </for>
        </body>
    </function>
</flowgorithm>
