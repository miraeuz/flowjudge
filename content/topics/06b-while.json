{
 "id": "while",
 "order": 6.5,
 "title": {
  "uz": "While — shartli tsikl",
  "en": "While — conditional loops"
 },
 "lesson": {
  "uz": "While shart rost bo'lguncha takrorlaydi. Necha marta takrorlanishi oldindan noma'lum bo'lganda ishlating.",
  "en": "While repeats as long as a condition is true. Use it when you do not know in advance how many repetitions you need."
 },
