{
  "name": "flowgorithm-academy",
  "productName": "Flowgorithm Academy",
  "version": "0.4.0",
  "description": "Learn algorithms with Flowgorithm \u2014 lessons, problems and an automatic judge.",
  "author": "miraeuz <miraeuz@users.noreply.github.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.mjs && node tests/security.mjs && node tests/curriculum.mjs",
    "dist": "electron-builder --win --publish never",
    "test:ui": "node tests/ui-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "uz.miraeuz.flowgorithmacademy",
    "productName": "Flowgorithm Academy",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "engine/**",
      "content/**",
      "config.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Flowgorithm-Academy-Setup-${version}.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
