{
  "name": "flowgorithm-academy",
  "productName": "Mirae Flow",
  "version": "0.9.0",
  "description": "Mirae Flow \u2014 learn programming with visual flowcharts: lessons, problems and an automatic judge.",
  "author": "miraeuz <miraeuz@users.noreply.github.com>",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.mjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "uz.miraeuz.miraeflow",
    "productName": "Mirae Flow",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "engine/**",
      "content/**",
      "config.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Mirae-Flow-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Education",
      "synopsis": "Learn algorithms with Flowgorithm",
      "artifactName": "Mirae-Flow-${version}-linux.${ext}"
    }
  }
}